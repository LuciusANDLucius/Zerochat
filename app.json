{
  "expo": {
    "name": "Zerochat",
    "slug": "Zerochat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zerochat",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.zerochat.blemesh",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Ứng dụng cần quyền Bluetooth để truyền và nhận tin nhắn Mesh ngoại tuyến qua sóng BLE.",
        "NSBluetoothPeripheralUsageDescription": "Ứng dụng cần phát tín hiệu BLE để chuyển tiếp tin nhắn qua bộ nhớ đệm trung gian.",
        "UIBackgroundModes": [
          "bluetooth-central",
          "bluetooth-peripheral"
        ]
      }
    },
    "android": {
      "package": "com.zerochat.blemesh",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidCompileSdkVersion.js",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothAlwaysPermission": "Ứng dụng cần quyền Bluetooth để truyền và nhận tin nhắn Mesh ngoại tuyến qua sóng BLE."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "63052778-d9ae-4460-8cd7-49fc6a6417ce"
      }
    },
    "owner": "luciusandlucius"
  }
}
